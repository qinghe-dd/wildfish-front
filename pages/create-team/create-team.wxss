.create-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部导航栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.back-btn {
  font-size: 36rpx;
  font-weight: bold;
  padding: 0 10rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
}

.publish-btn {
  font-size: 28rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

/* 表单内容 */
.form-content {
  padding: 20rpx;
}

.form-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 4rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 钓点选择 */
.selected-spot {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
  border: 2rpx solid #e8e8e8;
}

.spot-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.spot-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.spot-address {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.spot-distance {
  font-size: 22rpx;
  color: #999;
}

.spot-actions {
  display: flex;
  gap: 15rpx;
}

.spot-btn {
  flex: 1;
  padding: 15rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
}

.spot-btn.change {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.spot-btn.remove {
  background: #f5f5f5;
  color: #666;
}

.spot-options {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.option-card {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 25rpx;
  background: #f9f9f9;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
}

.option-icon {
  font-size: 40rpx;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.option-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.option-desc {
  font-size: 22rpx;
  color: #999;
}

.option-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.option-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.divider-text {
  font-size: 22rpx;
  color: #bbb;
  background: #fff;
  padding: 0 20rpx;
  position: relative;
}

.divider-text::before,
.divider-text::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 100rpx;
  height: 1rpx;
  background: #eee;
}

.divider-text::before {
  right: 100%;
}

.divider-text::after {
  left: 100%;
}

.manual-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

/* 选择器 */
.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #bbb;
}

/* 人数范围 */
.member-range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.range-control {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 15rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.range-label {
  font-size: 26rpx;
  color: #666;
}

.range-input {
  flex: 1;
  height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
}

.range-unit {
  font-size: 24rpx;
  color: #999;
}

.range-separator {
  font-size: 28rpx;
  color: #999;
}

/* 费用切换 */
.fee-toggle {
  display: flex;
  gap: 20rpx;
}

.toggle-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.toggle-option.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-color: transparent;
}

/* 费用输入 */
.fee-input-wrapper {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.fee-symbol {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.fee-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  border: none;
  background: transparent;
}

.fee-unit {
  font-size: 24rpx;
  color: #999;
}

/* 收款码上传 */
.upload-qr-btn {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 10rpx;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #999;
}

.upload-icon {
  font-size: 48rpx;
}

.qr-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.qr-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.remove-qr {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}

/* 支付方式选择 */
.payment-mode-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.payment-mode-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 15rpx;
  background: #fff;
  transition: all 0.3s;
}

.payment-mode-option.active {
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
}

.mode-icon {
  font-size: 48rpx;
}

.mode-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mode-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.mode-desc {
  font-size: 24rpx;
  color: #999;
}

.qr-tip {
  padding: 15rpx;
  background: #fff7e6;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #ff8800;
  margin-bottom: 20rpx;
}

.platform-tip {
  padding: 25rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tip-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #667eea;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 开关行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-desc {
  font-size: 26rpx;
  color: #666;
}

/* 文本域 */
.textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

/* 提示信息 */
.tips {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 10rpx;
}
