/* pages/settings/settings.wxss */
.settings-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 60rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

/* 设置分组 */
.settings-section {
  margin: 0 30rpx 30rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 15rpx;
  padding-left: 10rpx;
}

/* 功能列表 */
.function-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.function-item {
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 35rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}

.function-item:last-child {
  border-bottom: none;
}

.function-item:active {
  background: #f9f9f9;
}

.function-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.function-icon {
  font-size: 44rpx;
  line-height: 44rpx;
}

.function-name {
  font-size: 30rpx;
  color: #333;
}

.function-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cache-size {
  font-size: 26rpx;
  color: #999;
}

.function-arrow {
  font-size: 40rpx;
  color: #ccc;
  line-height: 40rpx;
}

/* 配置项样式 */
.config-item {
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 35rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.config-item:last-child {
  border-bottom: none;
}

.config-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.config-icon {
  font-size: 44rpx;
  line-height: 44rpx;
}

.config-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.config-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.config-desc {
  font-size: 24rpx;
  color: #999;
}

.config-switch {
  transform: scale(0.9);
}

.radius-input {
  width: 150rpx;
  height: 60rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.config-actions {
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.save-config-btn {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 20rpx;
  border: none;
}

.save-config-btn:active {
  opacity: 0.8;
}

.save-config-btn::after {
  border: none;
}

/* 退出登录按钮 */
.logout-wrapper {
  padding: 0 30rpx;
  margin-top: 40rpx;
}

.logout-btn {
  width: 100%;
  padding: 30rpx;
  background: #fff;
  color: #ff6b6b;
  font-size: 32rpx;
  border-radius: 20rpx;
  border: none;
}

.logout-btn:active {
  opacity: 0.8;
}

/* 版本信息 */
.version-info {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #999;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 70vh;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-content.large {
  width: 90%;
  max-height: 80vh;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #fff;
  color: #666;
  border-right: 1rpx solid #eee;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 表单样式 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  font-size: 28rpx;
}

/* 封禁记录列表 */
.ban-list {
  max-height: 50vh;
  overflow-y: auto;
}

.ban-item {
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.ban-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.ban-user-id {
  font-size: 26rpx;
  color: #666;
  word-break: break-all;
}

.ban-type {
  font-size: 24rpx;
  padding: 5rpx 15rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.ban-type.all {
  background: #ff6b6b;
  color: #fff;
}

.ban-type.paid {
  background: #ffa500;
  color: #fff;
}

.ban-type.free {
  background: #4ecdc4;
  color: #fff;
}

.ban-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 15rpx;
}

.ban-reason,
.ban-time,
.ban-expire {
  font-size: 24rpx;
  color: #999;
}

.ban-actions {
  display: flex;
  justify-content: flex-end;
}

.unban-btn {
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 10rpx;
}

.unban-btn::after {
  border: none;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 微信群二维码相关 */
.current-qr {
  display: flex;
  justify-content: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.current-qr-img {
  width: 400rpx;
  height: 400rpx;
}

.no-qr-tip {
  display: block;
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.upload-btn {
  width: 100%;
  padding: 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 10rpx;
  border: none;
}

.upload-btn::after {
  border: none;
}

.upload-btn:active {
  opacity: 0.8;
}

.preview-qr-img {
  width: 400rpx;
  height: 400rpx;
  display: block;
  margin: 0 auto;
  border-radius: 10rpx;
}

/* 电工检测配置相关 */
.config-info-box {
  background: #f0f7ff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
  border-left: 4rpx solid #1890ff;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 电工嫌疑人列表 */
.suspects-list {
  max-height: 60vh;
  overflow-y: auto;
}

.suspect-item {
  background: #fff5f5;
  border: 2rpx solid #ff6b6b;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.suspect-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.suspect-user-id {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  word-break: break-all;
}

.suspect-count {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: bold;
  padding: 5rpx 15rpx;
  background: rgba(255, 107, 107, 0.1);
  border-radius: 8rpx;
}

.suspect-spots {
  margin-bottom: 15rpx;
  padding: 15rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
}

.spots-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.spots-list {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.suspect-actions {
  display: flex;
  gap: 15rpx;
}

.suspect-btn {
  flex: 1;
  padding: 15rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  border: none;
}

.suspect-btn::after {
  border: none;
}

.suspect-btn.ban {
  background: #ff6b6b;
  color: #fff;
}

.suspect-btn.copy {
  background: #f0f0f0;
  color: #666;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 10rpx;
}

/* ========== 约钓支付配置相关 ========== */
.form-section {
  margin-bottom: 30rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.payment-mode-select {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.payment-mode-option {
  display: flex;
  align-items: center;
  padding: 25rpx 20rpx;
  background: #f9f9f9;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.payment-mode-option.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: #667eea;
  color: #667eea;
  font-weight: bold;
}

.payment-mode-option radio {
  margin-right: 15rpx;
  transform: scale(1.2);
}

.mode-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.mode-icon {
  font-size: 40rpx;
}

.mode-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.mode-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.mode-desc {
  font-size: 24rpx;
  color: #999;
}

.default-mode-options {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.default-mode-option {
  display: flex;
  align-items: center;
  padding: 25rpx 20rpx;
  background: #f9f9f9;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.default-mode-option.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: #667eea;
  color: #667eea;
  font-weight: bold;
}

.default-mode-option radio {
  margin-right: 15rpx;
  transform: scale(1.2);
}

.option-text {
  flex: 1;
}

.qr-code-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.current-qr {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.qr-label {
  font-size: 26rpx;
  color: #666;
}

.qr-img {
  width: 400rpx;
  height: 400rpx;
  border-radius: 10rpx;
  align-self: center;
}

.upload-section {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.preview-qr {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 15rpx;
  background: #fff7e6;
  border-radius: 10rpx;
}
