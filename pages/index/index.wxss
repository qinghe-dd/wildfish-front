/* ==================== 基础容器 ==================== */
page {
  margin: 0;
  padding: 0;
}

.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 0 0 80px 0;
  box-sizing: border-box;
}

/* ==================== 顶部图片 ==================== */
.shark-img {
  width: 100%;
  height: 180px;
  display: block;
}

/* ==================== 选择模式提示 ==================== */
.select-mode-banner {
  margin: 15rpx;
  padding: 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.select-mode-icon {
  font-size: 40rpx;
}

.select-mode-text {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* ==================== 微信群二维码 ==================== */
.wechat-group-section {
  margin: 0 30rpx 15rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 15rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.qr-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  text-align: left;
  flex-shrink: 0;
  width: 120rpx;
  line-height: 1.3;
}

.wechat-group-qr {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  background: #fff;
  padding: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  flex-shrink: 0;
  margin-top: -10rpx;
}

.qr-tip {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: right;
  flex-shrink: 0;
  width: 100rpx;
  line-height: 1.3;
}

/* ==================== 功能按钮区域 ==================== */
.func-group {
  display: flex;
  flex-wrap: wrap;
  padding: 15px;
  background-color: #fff;
  margin-bottom: 10px;
}

.map-btn {
  width: 100%;
  background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
  color: #fff;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  margin-bottom: 12px;
}

.map-icon {
  width: 44px;
  height: 44px;
}

.map-txt {
  margin-top: 10px;
  font-size: 16px;
  font-weight: 600;
}

.btn-item {
  width: calc(33.33% - 8px);
  background-color: #f8f8f8;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px 0;
  border: 1px solid #eee;
  transition: all 0.3s;
}

.btn-item:active {
  background-color: #e8e8e8;
  transform: scale(0.98);
}

.icon {
  width: 32px;
  height: 32px;
}

.btn-txt {
  margin-top: 8px;
  font-size: 13px;
  color: #333;
  font-weight: 500;
}

/* ==================== 筛选及搜索区域 ==================== */
.filter-section {
  background-color: #fff;
  padding: 15px;
  margin-bottom: 10px;
}

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 20px;
  padding: 10px 15px;
  margin-right: 12px;
}

.search-icon {
  width: 18px;
  height: 18px;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  font-size: 14px;
  color: #333;
}

.location-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: #f5f5f5;
  padding: 6px;
}

/* ==================== Tab样式标签栏 ==================== */
.spot-tabs {
  display: flex;
  background-color: #fff;
  border-radius: 12px;
  padding: 4px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}

.spot-tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12px 0;
  position: relative;
  transition: all 0.3s;
}

.spot-tab-item.tab-active {
  background-color: #1a1a1a;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.tab-text {
  font-size: 15px;
  color: #666;
  font-weight: 500;
}

.tab-active .tab-text {
  color: #fff;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 6px;
  width: 4px;
  height: 4px;
  background-color: #fff;
  border-radius: 50%;
}

/* ==================== 钓点列表区域 ==================== */
.spot-list {
  display: flex;
  flex-direction: column;
  padding: 10px 15px;
}

.spot-item {
  width: 100%;
  margin-bottom: 15px;
  background-color: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
  display: flex;
}

.spot-item:active {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
}

.spot-img {
  width: 120px;
  height: 120px;
  object-fit: cover;
  display: block;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.spot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 15px;
}

.distance-txt {
  font-size: 12px;
  color: #999;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
}

.spot-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 6px;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spot-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.paid-tag {
  padding: 4rpx 12rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 20rpx;
  font-size: 12px;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 10rpx;
}

/* 列表页举报警告标签 */
.report-badge-list {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ffa500 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 11px;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.report-badge-text {
  font-size: 11px;
}

.spot-desc {
  font-size: 13px;
  color: #999;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.6;
}

.empty-tip {
  width: 100%;
  text-align: center;
  padding: 40px 20px;
  color: #999;
  font-size: 14px;
}
.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1px solid #ccc;
  padding: 10px 0;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tab-icon {
  width: 25px;
  height: 25px;
}
.tab-txt {
  font-size: 12px;
  margin-top: 3px;
}
.tab-active {
  color: #000;
  font-weight: bold;
}

/* ==================== 筛选功能样式 ==================== */
.filter-btn-row {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  gap: 20rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.3s;
}

.filter-btn:active {
  background: #f5f5f5;
}

.filter-icon {
  font-size: 32rpx;
}

.filter-text {
  font-size: 28rpx;
  color: #333;
}

.filter-badge {
  width: 8rpx;
  height: 8rpx;
  background: #667eea;
  border-radius: 50%;
  display: block;
}

.filter-status {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 40rpx;
  border: 2rpx solid #667eea;
}

.status-text {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 500;
}

.clear-btn {
  font-size: 24rpx;
  color: #667eea;
  padding: 8rpx 16rpx;
}

.clear-btn:active {
  opacity: 0.7;
}

/* 筛选弹窗 */
.filter-modal-content {
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.filter-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.filter-modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.filter-modal-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.filter-item {
  margin-bottom: 40rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-option {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.3s;
}

.filter-option.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: #667eea;
}

.option-text {
  font-size: 26rpx;
  color: #666;
}

.filter-option.active .option-text {
  color: #667eea;
  font-weight: 500;
}

.filter-modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
  padding: 0;
}

.filter-reset-btn,
.filter-confirm-btn {
  flex: 1;
  padding: 30rpx;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
}

.filter-reset-btn {
  background: #fff;
  color: #666;
  border-right: 1rpx solid #eee;
}

.filter-reset-btn:active {
  background: #f9f9f9;
}

.filter-confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.filter-confirm-btn:active {
  opacity: 0.9;
}

.filter-reset-btn::after,
.filter-confirm-btn::after {
  border: none;
}