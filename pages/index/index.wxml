<view class="container">
  <!-- 微信群二维码 -->
  <view class="wechat-group-section" wx:if="{{wechatGroupQrCode}}">
    <view class="qr-title">扫码加入钓友群</view>
    <image class="wechat-group-qr" src="{{wechatGroupQrCode}}" mode="aspectFit" bindtap="previewQRCode" show-menu-by-longpress="{{true}}"/>
    <view class="qr-tip">长按识别</view>
  </view>

  <!-- 功能按钮区域 -->
  <view class="func-group" wx:if="{{!selectMode}}">
    <view class="map-btn" bindtap="goMap">
      <image class="map-icon" src="/images/content/icons/map_icon.jpeg" lazy-load="{{true}}"></image>
      <text class="map-txt">钓点地图</text>
    </view>
    <view class="btn-item" bindtap="markPoint">
      <image class="icon" src="/images/content/icons/map_icon.jpeg" lazy-load="{{true}}"></image>
      <text class="btn-txt">标记钓点</text>
    </view>
    <!-- <view class="btn-item" bindtap="goToTeamsList">
      <image class="icon" src="/images/content/photos/fish_album_icon.jpeg" lazy-load="{{true}}"></image>
      <text class="btn-txt">约钓组队</text>
    </view>
    <view class="btn-item" bindtap="photoIdentify">
      <image class="icon" src="/images/content/photo-icon.jpeg" lazy-load="{{true}}"></image>
      <text class="btn-txt">拍照识鱼</text>
    </view>
    <view class="btn-item" bindtap="fishAlbum">
      <image class="icon" src="/images/content/photos/fish_album_icon.jpeg" lazy-load="{{true}}"></image>
      <text class="btn-txt">鱼类图鉴</text>
    </view> -->
    <view class="btn-item" bindtap="weatherQuery">
      <image class="icon" src="/images/content/icons/water_level_icon.jpg" lazy-load="{{true}}"></image>
      <text class="btn-txt">天气查询</text>
    </view>
  </view>

  <!-- 筛选及搜索区域 -->
  <view class="filter-section">
    <view class="search-row">
      <view class="search-box">
        <image class="search-icon" src="/images/content/icons/search_icon.jpg" lazy-load="{{true}}"></image>
        <input class="search-input" placeholder="{{selectMode ? '搜索钓点名称' : '搜索钓点'}}" bindinput="onSearchInput" />
      </view>
      <image class="location-icon" src="/images/content/icons/search_icon.jpg" bindtap="getLocation" lazy-load="{{true}}"></image>
    </view>

    <!-- 筛选按钮行 -->
    <view class="filter-btn-row">
      <view class="filter-btn" bindtap="showFilterModal">
        <text class="filter-icon">🔍</text>
        <text class="filter-text">筛选</text>
        <text class="filter-badge" wx:if="{{hasActiveFilter}}">•</text>
      </view>
      <view class="filter-status" wx:if="{{hasActiveFilter}}">
        <text class="status-text">{{filterStatusText}}</text>
        <text class="clear-btn" bindtap="clearFilter">清除</text>
      </view>
    </view>

    <!-- 底部Tab样式标签栏 -->
    <view class="spot-tabs">
      <view class="spot-tab-item {{currentTab === 0 ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="0">
        <text class="tab-text">河流</text>
        <view class="tab-indicator" wx:if="{{currentTab === 0}}"></view>
      </view>
      <view class="spot-tab-item {{currentTab === 1 ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="1">
        <text class="tab-text">湖库</text>
        <view class="tab-indicator" wx:if="{{currentTab === 1}}"></view>
      </view>
      <view class="spot-tab-item {{currentTab === 2 ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="2">
        <text class="tab-text">野塘</text>
        <view class="tab-indicator" wx:if="{{currentTab === 2}}"></view>
      </view>
    </view>
  </view>

  <!-- 钓点列表区域 -->
  <view class="spot-list">
    <view class="spot-item" wx:for="{{spotList}}" wx:key="id" bindtap="goSpotDetail" data-id="{{item.id}}">
      <image
        class="spot-img"
        src="{{item.image}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        binderror="onImageError"
        bindload="onImageLoad"
        data-index="{{index}}"
      ></image>
      <view class="spot-info">
        <view class="spot-name-row">
          <text class="spot-name">{{item.name}}</text>
          <view class="paid-tag" wx:if="{{item.is_paid_spot}}">¥{{item.price}}</view>
          <!-- 举报警告标签 -->
          <view class="report-badge-list" wx:if="{{item.report_count > 0}}">
            <text class="report-badge-text">⚠️ {{item.report_count}}次举报</text>
          </view>
        </view>
        <text class="distance-txt">📍 {{item.distance}}</text>
        <text class="spot-desc">{{item.desc}}</text>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{spotList.length === 0}}">
      <text>暂无该类型钓点数据</text>
    </view>
  </view>

  <!-- 底部Tab栏 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTabBar === 0 ? 'tab-active' : ''}}" bindtap="switchTabBar" data-tab="0">
      <image class="tab-icon" src="/images/navBarimg/yediao.jpeg" lazy-load="{{true}}"></image>
      <text class="tab-txt">野钓</text>
    </view>
    <!-- <view class="tab-item {{currentTabBar === 1 ? 'tab-active' : ''}}" bindtap="switchTabBar" data-tab="1">
      <image class="tab-icon" src="/images/navBarimg/dongtai.jpeg" lazy-load="{{true}}"></image>
      <text class="tab-txt">动态</text>
    </view> -->
    <view class="tab-item {{currentTabBar === 2 ? 'tab-active' : ''}}" bindtap="switchTabBar" data-tab="2">
      <image class="tab-icon" src="/images/navBarimg/my.jpeg" lazy-load="{{true}}"></image>
      <text class="tab-txt">我的</text>
    </view>
  </view>

  <!-- 筛选弹窗 -->
  <view class="modal-mask" wx:if="{{showFilterModal}}" bindtap="hideFilterModal">
    <view class="filter-modal-content" catchtap="preventScroll">
      <view class="filter-modal-header">
        <text class="filter-modal-title">筛选条件</text>
        <text class="filter-modal-close" bindtap="hideFilterModal">×</text>
      </view>

      <view class="filter-modal-body">
        <!-- 城市筛选 -->
        <view class="filter-item">
          <text class="filter-label">城市</text>
          <view class="filter-options">
            <view class="filter-option {{filterCity === '' ? 'active' : ''}}" bindtap="selectCity" data-city="">
              <text class="option-text">全部</text>
            </view>
            <view class="filter-option {{filterCity === '北京' ? 'active' : ''}}" bindtap="selectCity" data-city="北京">
              <text class="option-text">北京</text>
            </view>
            <view class="filter-option {{filterCity === '上海' ? 'active' : ''}}" bindtap="selectCity" data-city="上海">
              <text class="option-text">上海</text>
            </view>
            <view class="filter-option {{filterCity === '广州' ? 'active' : ''}}" bindtap="selectCity" data-city="广州">
              <text class="option-text">广州</text>
            </view>
            <view class="filter-option {{filterCity === '深圳' ? 'active' : ''}}" bindtap="selectCity" data-city="深圳">
              <text class="option-text">深圳</text>
            </view>
            <view class="filter-option {{filterCity === '杭州' ? 'active' : ''}}" bindtap="selectCity" data-city="杭州">
              <text class="option-text">杭州</text>
            </view>
            <view class="filter-option {{filterCity === '成都' ? 'active' : ''}}" bindtap="selectCity" data-city="成都">
              <text class="option-text">成都</text>
            </view>
            <view class="filter-option {{filterCity === '合肥' ? 'active' : ''}}" bindtap="selectCity" data-city="合肥">
              <text class="option-text">合肥</text>
            </view>
          </view>
        </view>

        <!-- 距离筛选 -->
        <view class="filter-item">
          <text class="filter-label">距离</text>
          <view class="filter-options">
            <view class="filter-option {{filterDistance === null ? 'active' : ''}}" bindtap="selectDistance" data-distance="">
              <text class="option-text">不限</text>
            </view>
            <view class="filter-option {{filterDistance === 5 ? 'active' : ''}}" bindtap="selectDistance" data-distance="5">
              <text class="option-text">5公里内</text>
            </view>
            <view class="filter-option {{filterDistance === 10 ? 'active' : ''}}" bindtap="selectDistance" data-distance="10">
              <text class="option-text">10公里内</text>
            </view>
            <view class="filter-option {{filterDistance === 20 ? 'active' : ''}}" bindtap="selectDistance" data-distance="20">
              <text class="option-text">20公里内</text>
            </view>
            <view class="filter-option {{filterDistance === 50 ? 'active' : ''}}" bindtap="selectDistance" data-distance="50">
              <text class="option-text">50公里内</text>
            </view>
            <view class="filter-option {{filterDistance === 100 ? 'active' : ''}}" bindtap="selectDistance" data-distance="100">
              <text class="option-text">100公里内</text>
            </view>
          </view>
        </view>
      </view>

      <view class="filter-modal-footer">
        <button class="filter-reset-btn" bindtap="resetFilter">重置</button>
        <button class="filter-confirm-btn" bindtap="applyFilter">确定</button>
      </view>
    </view>
  </view>
</view>