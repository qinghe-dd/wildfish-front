.weather-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #fff;
  font-size: 28rpx;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.error-text {
  color: #fff;
  font-size: 28rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.retry-btn {
  padding: 20rpx 60rpx;
  background: #fff;
  color: #667eea;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 天气内容 */
.weather-content {
  padding-bottom: 40rpx;
}

/* 城市信息 */
.city-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 20rpx;
}

.city-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.update-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 当前天气卡片 */
.current-weather-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 30rpx;
}

.temp-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.current-temp {
  font-size: 120rpx;
  font-weight: bold;
  color: #333;
  line-height: 1;
}

.feels-temp {
  font-size: 28rpx;
  color: #999;
  margin-left: 20rpx;
  margin-top: 20rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.weather-text {
  font-size: 36rpx;
  color: #333;
  margin-right: 20rpx;
}

.weather-icon {
  font-size: 80rpx;
  line-height: 80rpx;
}

.weather-details {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.detail-item {
  flex: 1;
  min-width: 45%;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 钓鱼指数卡片 */
.fishing-index-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.index-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.index-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.index-category {
  font-size: 32rpx;
  font-weight: bold;
  color: #00B26A;
}

.index-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 其他生活指数 */
.other-indices {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.index-item {
  flex: 1;
  min-width: 45%;
  padding: 25rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.index-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.index-category-text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 3天预报 */
.forecast-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.forecast-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.forecast-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.forecast-item:last-child {
  border-bottom: none;
}

.forecast-date {
  font-size: 28rpx;
  color: #333;
  width: 150rpx;
}

.forecast-icon {
  font-size: 60rpx;
  line-height: 60rpx;
}

.forecast-temp {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.temp-high {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.temp-low {
  font-size: 28rpx;
  color: #999;
}

.forecast-text {
  font-size: 26rpx;
  color: #666;
  width: 150rpx;
  text-align: right;
}

/* ========== 搜索弹窗样式 ========== */

.header-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.search-btn {
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

/* 搜索弹窗 */
.search-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.search-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.search-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.search-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.search-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.search-modal-close {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}

/* 搜索输入框 */
.search-input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-submit-btn {
  padding: 15rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 搜索结果 */
.search-results {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.search-results-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.search-results-list {
  flex: 1;
}

.search-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 20rpx;
  background: #f9f9f9;
  border-radius: 15rpx;
  margin-bottom: 15rpx;
}

.result-info {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.result-location {
  font-size: 24rpx;
  color: #999;
}

.result-arrow {
  font-size: 40rpx;
  color: #667eea;
}

/* 搜索中状态 */
.search-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 热门城市 */
.hot-cities {
  flex: 1;
}

.hot-cities-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.hot-cities-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.hot-city-item {
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #333;
}

