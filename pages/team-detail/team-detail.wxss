.team-detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.back-btn, .share-btn {
  font-size: 32rpx;
  padding: 0 10rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 滚动区域 */
.detail-scroll {
  flex: 1;
  padding-bottom: 20rpx;
}

/* 团队头部 */
.team-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.team-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.team-meta {
  display: flex;
  gap: 20rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
}

.member-count {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 团队代码卡片 */
.team-code-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.code-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.code-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  font-family: monospace;
  letter-spacing: 2rpx;
}

.copy-btn {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.code-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 15rpx;
}

/* 信息区块 */
.info-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #666;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.info-value.fee {
  color: #ff6b35;
  font-weight: bold;
}

.info-value.free {
  color: #00B26A;
  font-weight: bold;
}

/* 描述区块 */
.description-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 队长信息 */
.captain-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.captain-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.captain-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.captain-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.captain-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.captain-time {
  font-size: 22rpx;
  color: #999;
}

/* 成员列表 */
.members-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.members-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.member-name {
  font-size: 26rpx;
  color: #333;
}

.member-status {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.member-status.pending {
  background: #faad14;
  color: #fff;
}

.member-status.approved {
  background: linear-gradient(135deg, #00B26A 0%, #00a859 100%);
  color: #fff;
}

.member-status.rejected {
  background: #f5f5f5;
  color: #999;
}

.member-actions {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  border: none;
}

.action-btn.approve {
  background: linear-gradient(135deg, #00B26A 0%, #00a859 100%);
  color: #fff;
}

.action-btn.reject {
  background: #f5f5f5;
  color: #666;
}

/* 留言区域 */
.messages-section {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

.messages-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-item.system {
  margin: 10rpx 0;
}

.system-message {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 15rpx;
  background: #f0f7ff;
  border-radius: 10rpx;
}

.system-icon {
  font-size: 24rpx;
}

.system-text {
  font-size: 22rpx;
  color: #1890ff;
}

.user-message {
  display: flex;
  gap: 15rpx;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.message-content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sender-name {
  font-size: 22rpx;
  color: #999;
}

.message-bubble {
  padding: 15rpx 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  max-width: 80%;
}

.message-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.message-image {
  max-width: 100%;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

.message-time {
  font-size: 20rpx;
  color: #bbb;
}

.messages-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

.messages-loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 底部间距 */
.bottom-spacer {
  height: 120rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.message-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 35rpx;
  font-size: 26rpx;
}

.send-btn {
  padding: 15rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 35rpx;
  font-size: 26rpx;
  border: none;
}

.image-btn {
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 36rpx;
  color: #666;
  border: none;
}

.action-bar {
  display: flex;
  justify-content: center;
}

.pending-text {
  font-size: 26rpx;
  color: #faad14;
}

.join-btn {
  width: 100%;
  padding: 25rpx;
  border-radius: 35rpx;
  font-size: 30rpx;
  border: none;
}

.join-btn.free {
  background: linear-gradient(135deg, #00B26A 0%, #00a859 100%);
  color: #fff;
}

.join-btn.paid {
  background: linear-gradient(135deg, #ff6b35 0%, #ff5500 100%);
  color: #fff;
}

.manage-btn {
  width: 100%;
  padding: 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 35rpx;
  font-size: 30rpx;
  border: none;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 1001;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.fee-info {
  text-align: center;
  margin-bottom: 30rpx;
}

.fee-amount {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #ff6b35;
}

.fee-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.qr-code-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.payment-qr {
  width: 400rpx;
  height: 400rpx;
  border-radius: 10rpx;
  border: 2rpx solid #eee;
}

.qr-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 15rpx;
}

.verify-input-area {
  margin-bottom: 30rpx;
}

.verify-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.verify-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 5rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
}

.team-code-area {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
}

.team-code-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.team-code-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.team-code {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  font-family: monospace;
}

.team-code-hint {
  font-size: 22rpx;
  color: #999;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
}

.modal-btn.cancel {
  background: #fff;
  color: #666;
  border-right: 1rpx solid #eee;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
