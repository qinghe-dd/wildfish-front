}

.password-confirm-btn {
  flex: 1;
  padding: 25rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.password-confirm-btn::after {
  border: none;
}

/* ============ 评价相关样式 ============ */

/* 评价区域 */
.reviews-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.reviews-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.reviews-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.write-review-btn {
  padding: 15rpx 30rpx;
  background: #00B26A;
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
  border: none;
}

.write-review-btn::after {
  border: none;
}

/* 评价列表 */
.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.review-item {
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.review-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.reviewer-nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.review-rating {
  display: flex;
  gap: 5rpx;
}

.star {
  font-size: 28rpx;
  color: #FFD700;
}

/* 评价内容 */
.review-comment {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.review-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.reviews-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 评价弹窗 */
.review-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.review-modal-content {
  position: relative;
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 3001;
  display: flex;
  flex-direction: column;
}

.review-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.review-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.review-modal-close {
  font-size: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.review-modal-body {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 30rpx;
}

/* 评分选择 */
.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
}

.rating-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.rating-stars {
  display: flex;
  gap: 10rpx;
}

.star-item {
  font-size: 48rpx;
