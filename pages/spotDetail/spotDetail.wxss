}

/* 评价图片上传 */
.review-images-section {
  margin-bottom: 30rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.review-images-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.preview-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  border: 2rpx solid #eee;
}

.delete-image-btn {
