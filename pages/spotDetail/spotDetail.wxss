  margin-bottom: 30rpx;
}

.password-input-field {
  width: 100%;
  padding: 25rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 10rpx;
  box-sizing: border-box;
}

.password-modal-footer {
  display: flex;
  gap: 20rpx;
}

.password-cancel-btn {
  flex: 1;
  padding: 25rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
}

.password-cancel-btn::after {
