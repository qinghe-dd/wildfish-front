}

.add-image-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  background: #f9f9f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  padding: 0;
}

.add-image-btn::after {
  border: none;
}

/* 评价弹窗底部按钮 */
.review-modal-footer {
  display: flex;
