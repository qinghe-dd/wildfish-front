  border: none;
}

.payment-modal-confirm-btn::after {
  border: none;
}

/* 密码输入弹窗 */
.password-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.password-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.password-modal-content {
  position: relative;
  width: 85%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 2001;
}

.password-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.password-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.password-modal-close {
  font-size: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.password-modal-body {
  margin-bottom: 40rpx;
}

.password-modal-desc {
  font-size: 28rpx;
  color: #666;
