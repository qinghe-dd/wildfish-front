  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.review-submit-btn::after {
  border: none;
}

/* 举报按钮 */
.report-btn-wrapper {
  position: fixed;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
}

.report-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff5252 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.4);
  border: none;
}

.report-btn::after {
  border: none;
}

.report-icon {
  font-size: 32rpx;
}

/* 举报弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  padding: 30rpx;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.report-modal-content {
  width: 85%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.modal-close {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
  opacity: 0.9;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 15rpx;
}

.form-label.required::before {
  content: '*';
  color: #ff6b6b;
  margin-right: 5rpx;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s;
}

.radio-item:active {
  background: #e9ecef;
}

.radio-item radio {
  transform: scale(1.2);
}

.radio-item text {
  font-size: 28rpx;
  color: #333;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: #ff6b6b;
  line-height: 1.6;
  padding: 15rpx;
  background: #fff5f5;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

.electrician-hint {
  display: block;
  font-size: 24rpx;
  color: #d63384;
  line-height: 2;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #ff6b6b;
  font-weight: 500;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.upload-evidence-btn {
  width: 100%;
  padding: 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  font-weight: 500;
}

.upload-evidence-btn::after {
  border: none;
}

.upload-evidence-btn:active {
  opacity: 0.9;
}

.evidence-preview {
  display: flex;
  gap: 15rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.evidence-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.evidence-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.evidence-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  font-weight: bold;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
  padding: 0;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  font-weight: 500;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #fff;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
