/* pages/my-favorites/my-favorites.wxss */
.favorites-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 60rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

/* 加载和空状态 */
.loading-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 钓点列表 */
.spots-list {
  padding: 0 30rpx;
  margin-top: -30rpx;
}

.spot-item {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.spot-item:active {
  opacity: 0.95;
}

/* 钓点图片 */
.spot-image-wrapper {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.spot-image {
  width: 100%;
  height: 100%;
}

.spot-type-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 10rpx 20rpx;
  background: rgba(102, 126, 234, 0.9);
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.favorite-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 40rpx;
}

/* 钓点信息 */
.spot-info {
  padding: 30rpx;
}

.spot-header {
  margin-bottom: 20rpx;
}

.spot-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.spot-details {
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #999;
  min-width: 140rpx;
}

.detail-value {
  color: #666;
  flex: 1;
}

/* 钓点操作 */
.spot-actions {
  display: flex;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.unfavorite-btn {
  width: 100%;
  padding: 15rpx;
  font-size: 26rpx;
  color: #ff6b6b;
  background: #fff;
  border: 1rpx solid #ff6b6b;
  border-radius: 10rpx;
}
