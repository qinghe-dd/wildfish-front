/* pages/my-spots/my-spots.wxss */
.my-spots-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 60rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  margin: 40rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background: #fff;
  margin: 40rpx 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 钓点列表 */
.spots-list {
  padding: 0 30rpx;
  margin-top: -30rpx;
}

.spot-item {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.spot-item:active {
  opacity: 0.95;
}

/* 钓点图片 */
.spot-image-wrapper {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.spot-image {
  width: 100%;
  height: 100%;
}

.spot-type-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 10rpx 20rpx;
  background: rgba(102, 126, 234, 0.9);
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
}

/* 钓点信息 */
.spot-info {
  padding: 30rpx;
}

.spot-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.spot-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.spot-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-left: 20rpx;
}

.spot-free {
  font-size: 28rpx;
  color: #00B26A;
  margin-left: 20rpx;
}

/* 钓点详情 */
.spot-details {
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #999;
  min-width: 140rpx;
}

.detail-value {
  color: #666;
  flex: 1;
}

/* 钓点操作 */
.spot-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-text {
  font-size: 26rpx;
  color: #667eea;
}
