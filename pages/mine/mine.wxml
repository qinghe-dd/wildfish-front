<!--pages/mine/mine.wxml-->
<view class="mine-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info" bindtap="showProfileEditor">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="user-nickname">{{userInfo.nickName || '钓鱼人'}}</text>
        <text class="user-id">ID: {{userId || '未登录'}}</text>
      </view>
      <text class="edit-hint">编辑</text>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="goToMySpots">
      <text class="stat-value">{{stats.mySpotsCount || 0}}</text>
      <text class="stat-label">我的钓点</text>
    </view>
    <view class="stat-divider"></view>
    <!-- <view class="stat-item" bindtap="goToMyPosts">
      <text class="stat-value">{{stats.myPostsCount || 0}}</text>
      <text class="stat-label">我的动态</text>
    </view>
    <view class="stat-divider"></view> -->
    <view class="stat-item" bindtap="goToMyFavorites">
      <text class="stat-value">{{stats.favoriteCount || 0}}</text>
      <text class="stat-label">收藏钓点</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="function-list">
    <view class="function-item" bindtap="goToMySpots">
      <view class="function-left">
        <text class="function-icon">📍</text>
        <text class="function-name">我标记的钓点</text>
      </view>
      <text class="function-arrow">→</text>
    </view>

    <!-- <view class="function-item" bindtap="goToMyPosts">
      <view class="function-left">
        <text class="function-icon">📝</text>
        <text class="function-name">我发布的动态</text>
      </view>
      <text class="function-arrow">→</text>
    </view> -->

    <view class="function-item" bindtap="goToMyFavorites">
      <view class="function-left">
        <text class="function-icon">⭐</text>
        <text class="function-name">收藏的钓点</text>
      </view>
      <text class="function-arrow">→</text>
    </view>
  </view>

  <!-- 设置功能 -->
  <view class="function-list">
    <view class="function-item" bindtap="goToSettings">
      <view class="function-left">
        <text class="function-icon">⚙️</text>
        <text class="function-name">设置</text>
      </view>
      <text class="function-arrow">→</text>
    </view>
  </view>

  <!-- 资料编辑弹窗 - 遮罩层与内容层分离，防止原生 input 点击穿透导致关闭 -->
  <view class="profile-editor-mask" wx:if="{{showProfileEditor}}" bindtap="hideProfileEditor"></view>
  <view class="profile-editor-overlay" wx:if="{{showProfileEditor}}" catchtap="preventBubble">
    <view class="profile-editor">
      <view class="profile-editor-title">编辑资料</view>

      <!-- 头像选择 -->
      <view class="profile-avatar-section">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="profile-avatar" src="{{userInfo.avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
          <text class="avatar-hint">点击更换头像</text>
        </button>
      </view>

      <!-- 昵称输入 -->
      <view class="profile-nickname-section">
        <text class="profile-label">昵称</text>
        <input class="profile-nickname-input" type="nickname" value="{{editNickname}}" bindinput="onNicknameInput" bindblur="onNicknameConfirm" placeholder="请输入昵称" />
      </view>

      <!-- 操作按钮 -->
      <view class="profile-editor-actions">
        <view class="profile-btn profile-btn-cancel" bindtap="hideProfileEditor">取消</view>
        <view class="profile-btn profile-btn-save" bindtap="saveProfile">保存</view>
      </view>
    </view>
  </view>
</view>
